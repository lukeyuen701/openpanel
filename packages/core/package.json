{
  "name": "@openpanel/core",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./modules/*.constants": "./src/modules/*.constants.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate",
    "codegen": "bun scripts/download-geo.ts && bun scripts/get-datacenter-asns.ts",
    "gen:asns": "bun scripts/get-datacenter-asns.ts",
    "gen:bots": "bun scripts/get-bots.ts && biome format --write ./src/modules/ingest/src/bots/bots.ts",
    "gen:referrers": "bun scripts/get-referrers.ts && biome format --write ./src/shared/referrers/index.ts",
    "gen:llm-prices": "bun scripts/get-llm-prices.ts",
    "with-env": "dotenv -e ../../.env -c --"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.106",
    "@ai-sdk/openai": "4.0.121",
    "@aws-sdk/client-s3": "3.1172.0",
    "@aws-sdk/client-sts": "3.1172.0",
    "@babel/parser": "7.29.14",
    "@bull-board/api": "9.13.2",
    "@bull-board/elysia": "9.13.2",
    "@elysiajs/cors": "1.4.3",
    "@elysiajs/openapi": "1.4.17",
    "@google-cloud/storage": "7.22.0",
    "@hyperdx/node-opentelemetry": "catalog:",
    "@maxmind/geoip2-node": "6.3.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "2.2.2",
    "@openpanel/ai": "workspace:*",
    "@openpanel/db": "workspace:*",
    "@openpanel/email": "workspace:*",
    "@openpanel/payments": "workspace:*",
    "@openpanel/redis": "workspace:*",
    "@openpanel/sdk": "workspace:*",
    "@openpanel/shared": "workspace:*",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@slack/oauth": "4.0.0",
    "@trpc/server": "11.27.0",
    "ai": "7.0.177",
    "arctic": "2.3.0",
    "better-auth": "1.7.26",
    "bullmq": "6.7.8",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.3",
    "date-fns": "3.6.0",
    "elysia": "1.4.32",
    "fast-deep-equal": "3.1.3",
    "fast-json-stable-hash": "1.0.3",
    "js-yaml": "4.3.2",
    "kafkajs": "2.2.4",
    "lru-cache": "11.5.3",
    "mathjs": "12.4.3",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "prisma-error-enum": "0.1.3",
    "prom-client": "15.1.3",
    "ramda": "0.29.1",
    "re2js": "2.10.0",
    "short-unique-id": "5.3.2",
    "superjson": "2.2.6",
    "unzipper": "0.12.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clickhouse/client": "1.25.0",
    "@openpanel/tsconfig": "workspace:*",
    "@types/js-yaml": "4.0.9",
    "@types/ramda": "0.31.0",
    "@types/unzipper": "0.10.11",
    "bun-types": "1.4.5",
    "tar": "7.5.23",
    "typescript": "catalog:"
  }
}
