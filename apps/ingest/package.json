{
  "name": "@openpanel/ingest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "go build -trimpath -o bin/ingest ./cmd/ingest",
    "dev": "go build -o bin/ingest ./cmd/ingest && dotenv -e ../../.env -- ./bin/ingest",
    "test": "go vet ./... && go test ./...",
    "gen": "bun scripts/gen-tables.ts",
    "gen:check": "bun scripts/gen-tables.ts --check && bun scripts/gen-referrers.ts --check",
    "worker-parity": "dotenv -e ../../.env -- bun parity/worker-diff.ts",
    "golden": "bun parity/golden-core.ts",
    "golden:jsport": "bun parity/golden-jsport.ts",
    "gen:referrers": "bun scripts/gen-referrers.ts",
    "gen:referrers:check": "bun scripts/gen-referrers.ts --check",
    "golden:notify": "bun parity/golden-notify.ts",
    "golden:consumer": "bun parity/golden-consumer.ts",
    "golden:bullmq": "bun parity/golden-bullmq.ts",
    "parity": "go build -o bin/ingest ./cmd/ingest && dotenv -e ../../.env -- bun parity/diff.ts",
    "loadgen": "go run ./cmd/loadgen"
  }
}
